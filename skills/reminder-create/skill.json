{
  "id": "reminder.create",
  "name": "新建提醒",
  "category": "notify",
  "summary": "排一条提醒，到点推到钉钉。",
  "method": "POST",
  "endpoint": "/reminders",
  "adminOnly": true,
  "composable": false,
  "mode": "request",
  "params": [
    {
      "key": "title",
      "label": "标题",
      "type": "text",
      "required": true,
      "placeholder": "例如：周五前提交周报"
    },
    {
      "key": "remindAt",
      "label": "触发时间",
      "type": "datetime",
      "required": true
    },
    {
      "key": "content",
      "label": "内容",
      "type": "text",
      "required": false,
      "placeholder": "可留空"
    }
  ],
  "returns": "新建好的提醒记录。"
}
