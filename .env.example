# ===== 服务端配置（复制为 .env 后由启动脚本注入，或直接用系统环境变量）=====
#
# 注意：本文件不会被自动加载。请执行 `cp .env.example .env`（Windows:
# `copy .env.example .env`）后再填写。所有必填项留空等同于「未配置」，
# 服务端会在启动时直接报错退出，而不是静默使用弱默认值。
#
# 变量名统一用 WORKHUB_ 前缀（跟产品名对齐）。
# 旧前缀 MDHUB_ 不再认：配了它等于没配。
# 不保留旧名的理由：两套名长期并存，「改了新名却因为旧名还在而没生效」
# 比直接不生效更难查；一次性改名到位的成本只有一次。

# JWT 签名、Agent Key 加密与文档加密主密钥的种子，生产环境必须设置为随机长字符串。
# 长度不足 32 字符会被拒绝启动；生产环境缺失会直接拒绝启动。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKHUB_SECRET=

# 管理员密码（仅首次初始化建库时写入 users 表）。
# 留空则使用初始部署密码 admin（登录后请立刻改掉）。
# 密码还是初始值时，网页端会一直提醒；不配也不会拒绝启动。
WORKHUB_ADMIN_PASSWORD=

# 服务端监听端口，默认 8787
WORKHUB_PORT=8787

# 前端 dev server 端口，默认 8080。
# 局域网内其他设备访问的是这个端口（http://<本机内网IP>:8080），
# 而不是上面的 WORKHUB_PORT——/api 由前端 dev server 代理到服务端。
WORKHUB_WEB_PORT=8080

# 数据库路径（索引库），默认 <项目根>/data/workhub-v2.db，首次启动会自动建库。
# WORKHUB_DB 是 v1 时代的旧变量，仅作兼容兜底，不要再写。
#
# 这两项注释掉即可，不要留空值。
# 空值本身按「未配置」处理，但留着空行容易让人以为「配了却没生效」。
# WORKHUB_DB_V2=

# 仓库目录：文档正文实际存放的位置，默认 <项目根>/data/vault。
# 与数据库同处 data/ 下，data/ 已被 .gitignore 忽略。
# WORKHUB_VAULT_DIR=

# 日志级别：silent（不打印）/ error / warn / info（默认）/ debug
# error 与 warn 走 stderr，info 与 debug 走 stdout。
# 初始管理员密码的提示不受该开关影响，始终打印。
# WORKHUB_LOG_LEVEL=info

# ===== 仅限本地开发 =====
# 置为 1 时，允许服务端在未配置 WORKHUB_SECRET 的情况下**本地自动生成**一把密钥：
# 首次启动生成 32 字节随机密钥，存到数据库旁边的 .workhub-local-secret，重启后不变。
# 它同时是 JWT 签名与 API Key 加密主密钥的种子，删掉它旧密文就解不开了。
# 管理员密码与这个开关无关：留空就是初始部署密码 admin。
# 这样生成的密钥只属于这一台机器，旁人也猜不到。
# 该开关在 NODE_ENV=production 时无效——生产环境无论如何都要求显式配置。
# WORKHUB_ALLOW_LOCAL_CREDENTIALS=1

# 置为 production 时启用生产模式，强制要求显式配置密钥与管理员密码。
# NODE_ENV=production

# ===== 示例数据 =====
# 置为 1 时，首次建库会写入 shared/seed.ts 中的示例文档，便于快速体验。
# 正式部署请保持关闭，此时新库为空库。
# 库建好后再开启不会补数据（仅在 nodes 表为空时灌入）。
# WORKHUB_SEED_DEMO=1

# ===== 自动升级 =====
# 这几项不填也能用：默认去 GitHub 的 PAY7UN/WORKHUB 比对版本。
# 私有仓库或自建发布页才需要配。

# 自动升级用的 GitHub 仓库（owner/repo）
# WORKHUB_UPDATE_REPO=PAY7UN/WORKHUB

# 自定义更新清单地址（JSON：版本号 + 每个文件的 sha256）。设了就不走 GitHub。
# WORKHUB_UPDATE_MANIFEST=

# 升级包直链。设了直接从这个地址下载，不走仓库发布页。
# WORKHUB_UPDATE_URL=

# 下载升级包用的 Bearer 令牌（私有仓库或私有清单用）。
# WORKHUB_UPDATE_TOKEN=

# 升级后由谁把服务拉起来的自定义命令。
# 不设则按托管方式判断：托盘 / Windows 服务宿主 / systemd / pm2 / docker，
# 都没人管时由更新器自己拉起。
# WORKHUB_RESTART_CMD=

# ===== 会话采集器（可选）=====
# 定时把本机 CodeBuddy 的会话痕迹（改过的文件与 diff）用 Agent 汇总成工作日志，
# 按「<文件夹>/<日期>.md」写入文档（默认仓库下，默认文件夹「日常工作日志」）。
# 需要 Agent 已配置模型凭据（管理后台 → Agent 设置）。

# 置 1 启用
# WORKHUB_COLLECTOR_ENABLED=1

# CodeBuddy 存储目录覆盖（默认 %APPDATA%\CodeBuddy CN\User\globalStorage\tencent-cloud.coding-copilot）
# WORKHUB_COLLECTOR_CODEBUDDY_DIR=

# 会话静默多少分钟才算「结束」（默认 10）
# WORKHUB_COLLECTOR_IDLE_MINUTES=10

# 日志文件夹名（默认 日常工作日志）
# WORKHUB_COLLECTOR_FOLDER=日常工作日志

# 指定日志所属仓库 id（默认取最早的仓库）
# WORKHUB_COLLECTOR_REPO=
