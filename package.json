{
  "name": "workhub",
  "private": true,
  "version": "0.1.0",
  "description": "文档与原件一体化归档平台：文档与 Agent 配置存服务端，访客浏览器不持有不可见文档与模型凭据",
  "license": "MIT",
  "author": "PAY7UN",
  "homepage": "https://github.com/PAY7UN/WORKHUB#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PAY7UN/WORKHUB.git"
  },
  "bugs": {
    "url": "https://github.com/PAY7UN/WORKHUB/issues"
  },
  "keywords": [
    "markdown",
    "knowledge-base",
    "documentation",
    "rag",
    "llm",
    "sqlite",
    "express",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "server:built": "node --env-file-if-exists=.env server/index.js",
    "tray": "electron tray",
    "build:server": "node scripts/build-server.mjs",
    "pack:tray": "node scripts/pack-tray.mjs",
    "pack:server": "node scripts/pack-server.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "dev:all": "concurrently -n api,web -c magenta,cyan \"npm run server\" \"npm run dev\"",
    "admin:password": "node --env-file-if-exists=.env server/resetAdminPassword.ts",
    "manage:token": "node --env-file-if-exists=.env server/manageToken.ts",
    "service:install": "powershell -ExecutionPolicy Bypass -File scripts/install-service.ps1",
    "service:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-service.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "docs:list": "node scripts/docs.mjs --list",
    "docs:export": "node scripts/docs.mjs --export",
    "test": "node --test",
    "verify": "node scripts/verify.mjs",
    "verify:upgrade": "node scripts/verify-upgrade.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "marked": "^18.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
